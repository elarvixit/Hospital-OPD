{
  "name": "elarvix-opd",
  "version": "1.0.0",
  "description": "Hospital OPD queue and appointments system",
  "main": "src/app.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "autopush": "node scripts/autopush.js",
    "setup-hooks": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "express": "^4.21.2"
  }
}
